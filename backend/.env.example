# --- HTTP ---
PORT=4000

# --- AI provider (anthropic | openai | mock) ---
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Storage (local | s3) ---
STORAGE_PROVIDER=local
STORAGE_DIR=../storage

# --- Database ---
DB_PATH=../data/app.db

# --- Optional external furniture catalog ---
# EXTERNAL_CATALOG_URL=https://example.com/catalog.json
